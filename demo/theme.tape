Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 28
Set Margin 0
Set WindowBar ""
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme { "name": "zvm", "background": "#1d1611", "foreground": "#f1e9df", "cursor": "#ff8c00", "selection": "#4a3a2e", "black": "#2a201a", "red": "#ff5a2a", "green": "#b9c97a", "yellow": "#ffb347", "blue": "#8fb3c9", "magenta": "#d79bb5", "cyan": "#86c3b8", "white": "#e6ddd2", "brightBlack": "#7c6d61", "brightRed": "#ff7a50", "brightGreen": "#cfdc95", "brightYellow": "#ffc670", "brightBlue": "#a9c6d8", "brightMagenta": "#e6b3c9", "brightCyan": "#a3d6cc", "brightWhite": "#fff8f0" }
