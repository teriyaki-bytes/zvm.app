---
import { getCollection } from 'astro:content';
import { normalizePagePath, type PreviewIndex } from '../lib/link-previews';

interface Props {
  /** Disable all previews, or only links matching this CSS selector. */
  off?: boolean | string;
}

const { off = false } = Astro.props;
if (off === true) return null;

const pages: PreviewIndex = {};
const entries = await getCollection('docs', ({ data }) => !data.draft);

for (const entry of entries) {
  const cover = entry.data.cover;
  const image = cover && ('image' in cover ? cover.image : cover.light);
  const path = normalizePagePath(`/${entry.id === 'index' ? '' : entry.id}`);
  pages[path] = {
    title: entry.data.title,
    description: entry.data.description || entry.data.excerpt || `Read ${entry.data.title} in the ZVM documentation.`,
    ...(image && {
      image: { src: typeof image === 'string' ? image : image.src, alt: cover.alt },
    }),
  };
}
if (entries.some((entry) => entry.id.startsWith('blog/'))) {
  pages['/blog/'] = {
    title: 'ZVM Blog',
    description: 'Release notes, new features, and updates from Zig Version Manager.',
  };
}
---

<script is:inline id="link-preview-pages" type="application/json" set:html={JSON.stringify(pages).replace(/</g, '\\u003c')} />
<aside id="link-preview" role="tooltip" data-off={typeof off === 'string' ? off : undefined} hidden>
  <img data-preview-image alt="" hidden />
  <div class="preview-copy">
    <span class="preview-label">ZVM · Page preview</span>
    <p class="preview-title" data-preview-title></p>
    <p class="preview-description" data-preview-description></p>
  </div>
</aside>

<script>
  import { resolvePagePreview, type PreviewIndex } from '../lib/link-previews';

  function initLinkPreviews() {
    const popup = document.querySelector<HTMLElement>('#link-preview');
    const data = document.querySelector('#link-preview-pages');
    if (!popup || !data || popup.dataset.ready) return;
    popup.dataset.ready = 'true';

    const pages: PreviewIndex = JSON.parse(data.textContent || '{}');
    const title = popup.querySelector<HTMLElement>('[data-preview-title]')!;
    const description = popup.querySelector<HTMLElement>('[data-preview-description]')!;
    const image = popup.querySelector<HTMLImageElement>('[data-preview-image]')!;
    const events = new AbortController();
    const { signal } = events;
    const off = popup.dataset.off;
    let active: HTMLAnchorElement | undefined;
    let dismissed: HTMLAnchorElement | undefined;
    let openTimer: number | undefined;
    let closeTimer: number | undefined;

    function close() {
      window.clearTimeout(openTimer);
      window.clearTimeout(closeTimer);
      if (active) {
        const descriptions = (active.getAttribute('aria-describedby') || '')
          .split(/\s+/).filter((id) => id && id !== popup!.id);
        if (descriptions.length) active.setAttribute('aria-describedby', descriptions.join(' '));
        else active.removeAttribute('aria-describedby');
      }
      active = undefined;
      popup!.hidden = true;
    }

    function position() {
      if (!active) return;
      const link = active.getBoundingClientRect();
      const card = popup!.getBoundingClientRect();
      const gap = 10;
      const edge = 16;
      const left = Math.max(edge, Math.min(link.left + link.width / 2 - card.width / 2, innerWidth - card.width - edge));
      const below = link.bottom + gap;
      const top = below + card.height <= innerHeight - edge ? below : link.top - card.height - gap;
      popup!.style.left = `${left}px`;
      popup!.style.top = `${Math.max(edge, Math.min(top, innerHeight - card.height - edge))}px`;
    }

    function open(link: HTMLAnchorElement) {
      const preview = resolvePagePreview(link.href, location.href, pages);
      if (!preview || dismissed === link) return;
      close();
      active = link;
      title.textContent = preview.title;
      description.textContent = preview.description;
      image.hidden = !preview.image;
      image.removeAttribute('src');
      if (preview.image) {
        image.src = preview.image.src;
        image.alt = preview.image.alt;
      }
      const descriptions = link.getAttribute('aria-describedby');
      link.setAttribute('aria-describedby', [descriptions, popup!.id].filter(Boolean).join(' '));
      popup!.hidden = false;
      position();
    }

    function contentLink(target: EventTarget | null) {
      const link = target instanceof Element ? target.closest<HTMLAnchorElement>('main a[href]') : null;
      if (!link || link.hasAttribute('download') || link.closest('[data-no-preview]') || link.classList.contains('sl-anchor-link')) return;
      if (off && link.closest(off)) return;
      return link;
    }

    function scheduleClose() {
      window.clearTimeout(openTimer);
      window.clearTimeout(closeTimer);
      if (active === document.activeElement) return;
      closeTimer = window.setTimeout(close, 150);
    }

    document.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'touch') return;
      const link = contentLink(event.target);
      if (!link || (event.relatedTarget instanceof Node && link.contains(event.relatedTarget))) return;
      window.clearTimeout(closeTimer);
      window.clearTimeout(openTimer);
      if (link === active) return;
      close();
      openTimer = window.setTimeout(() => open(link), 250);
    }, { signal });

    document.addEventListener('pointerout', (event) => {
      const link = contentLink(event.target);
      if (!link || (event.relatedTarget instanceof Node && link.contains(event.relatedTarget))) return;
      if (dismissed === link) dismissed = undefined;
      scheduleClose();
    }, { signal });

    popup.addEventListener('pointerenter', () => window.clearTimeout(closeTimer), { signal });
    popup.addEventListener('pointerleave', scheduleClose, { signal });
    image.addEventListener('load', position, { signal });
    image.addEventListener('error', () => { image.hidden = true; position(); }, { signal });
    document.addEventListener('focusin', (event) => {
      const link = contentLink(event.target);
      if (link?.matches(':focus-visible')) open(link);
    }, { signal });
    document.addEventListener('focusout', () => { dismissed = undefined; close(); }, { signal });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      dismissed = active;
      close();
    }, { signal });
    document.addEventListener('click', close, { signal });
    document.addEventListener('scroll', close, { capture: true, passive: true, signal });
    window.addEventListener('resize', close, { signal });
    document.addEventListener('astro:before-swap', () => { close(); events.abort(); }, { once: true, signal });
  }

  initLinkPreviews();
  document.addEventListener('astro:page-load', initLinkPreviews);
</script>

<style>
  #link-preview {
    position: fixed;
    z-index: 100;
    width: min(23rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: 0;
    padding: 0;
    overflow: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: 0 8px 32px #0003, 0 2px 8px #0002;
    font-family: var(--sl-font);
    line-height: 1.6;
  }

  #link-preview[hidden], #link-preview img[hidden] { display: none; }
  #link-preview img { display: block; width: 100%; height: 10rem; object-fit: cover; background: white; }
  .preview-copy { padding: 1.1rem 1.25rem 1.25rem; }
  .preview-label { color: var(--sl-color-gray-3); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .preview-title { margin: 0.4rem 0 0; color: var(--sl-color-white); font-size: 1.125rem; font-weight: 650; line-height: 1.35; }
  .preview-description { margin: 0.65rem 0 0; font-size: 0.9rem; }
</style>
