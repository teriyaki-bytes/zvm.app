---
// OS-detecting install script tabs component
const tabs = [
  {
    id: 'bash',
    label: 'Linux & macOS',
    command: 'curl https://www.zvm.app/install.sh | bash',
    scriptUrl: 'https://github.com/tristanisham/zvm/blob/master/install.sh',
    note: null,
  },
  {
    id: 'pwsh',
    label: 'Windows',
    command: 'irm https://www.zvm.app/install.ps1 | iex',
    scriptUrl: 'https://github.com/tristanisham/zvm/blob/master/install.ps1',
    note: 'Run this in PowerShell. Using WSL? Use the Linux & macOS command instead.',
  },
  {
    id: 'go',
    label: 'Go',
    command: 'go install -ldflags "-s -w" github.com/tristanisham/zvm@latest',
    scriptUrl: null,
    note: 'Needs Go installed. The binary lands in your Go bin directory.',
  },
];
---

<div class="install-tabs">
  <div class="tab-buttons" role="tablist" aria-label="Install method">
    {tabs.map((tab, index) => (
      <button
        role="tab"
        class="tab-button"
        id={`tab-${tab.id}`}
        data-tab={tab.id}
        data-ph-event={`tab_${tab.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${tab.id}`}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div class="tab-panels">
    {tabs.map((tab, index) => (
      <div
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        class="tab-panel"
        data-panel={tab.id}
        hidden={index !== 0}
      >
        <div class="code-block">
          <span class="prompt" aria-hidden="true">$</span>
          <code class="command" data-method={tab.id}>{tab.command}</code>
          <button
            class="copy-button"
            data-command={tab.command}
            data-method={tab.id}
            data-ph-event={`copy_command_${tab.id}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-label" aria-live="polite">Copy</span>
          </button>
        </div>
        {tab.note && <p class="tab-note">{tab.note}</p>}
        {tab.scriptUrl && (
          <a
            href={tab.scriptUrl}
            class="view-script"
            target="_blank"
            rel="noopener noreferrer"
            data-ph-event={`view_script_${tab.id}`}
          >
            Read the script before you run it
          </a>
        )}
      </div>
    ))}
  </div>

  <p class="next-step" hidden aria-live="polite">
    When it finishes, open a new terminal and run <code>zvm i master</code>.
    <a href="/guides/install-zvm/" data-ph-event="cta_next_install_guide">See the full setup</a>
  </p>

  <p class="on-phone">
    This command runs on your computer.
    <button type="button" class="share-button" data-ph-event="share_install_link">Send this page to yourself</button>
  </p>
</div>

<style>
  .install-tabs {
    max-width: 40rem;
  }

  .tab-buttons {
    display: flex;
    gap: 0.25rem;
  }

  .tab-button {
    background: transparent;
    border: 2px solid transparent;
    border-bottom: 0;
    border-radius: 0.6rem 0.6rem 0 0;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .tab-button:hover {
    color: var(--sl-color-white);
  }

  .tab-button[aria-selected='true'] {
    color: var(--sl-color-white);
    border-color: var(--zvm-ink);
    background: var(--sl-color-gray-6);
  }

  :global([data-theme='dark']) .tab-button[aria-selected='true'] {
    border-color: var(--sl-color-gray-5);
  }

  .code-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 2px solid var(--zvm-ink);
    border-radius: 0 0.75rem 0.75rem 0.75rem;
    background: var(--sl-color-gray-6);
    padding: 0.8rem 0.6rem 0.8rem 1.1rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
  }

  :global([data-theme='dark']) .code-block {
    border-color: var(--sl-color-gray-5);
  }

  .prompt {
    color: var(--sl-color-accent);
    flex-shrink: 0;
    user-select: none;
  }

  .command {
    flex-grow: 1;
    overflow-x: auto;
    white-space: nowrap;
    color: var(--sl-color-white);
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    border: 0;
    border-radius: 0.4rem;
    padding: 0.35rem 0.55rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-family: var(--__sl-font);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .copy-button:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-5);
  }

  .copy-button.copied {
    color: var(--sl-color-white);
  }

  .tab-note {
    margin: 0.6rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .next-step {
    margin: 0.9rem 0 0;
    padding: 0.7rem 0.9rem;
    border-left: 3px solid var(--zvm-orange);
    background: var(--sl-color-gray-6);
    border-radius: 0 0.5rem 0.5rem 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
  }

  .next-step code {
    font-family: var(--__sl-font-mono);
    font-size: 0.95em;
  }

  .next-step a,
  .share-button {
    color: var(--sl-color-text-accent);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .on-phone {
    display: none;
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .share-button {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  @media (pointer: coarse) and (max-width: 50rem) {
    .on-phone {
      display: block;
    }
  }

  .view-script {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-underline-offset: 0.2em;
  }

  .view-script:hover {
    color: var(--sl-color-white);
  }

  @media (max-width: 600px) {
    .command {
      white-space: pre-wrap;
      word-break: break-all;
    }
  }
</style>

<script>
  type Capture = (event: string, props?: Record<string, unknown>) => void;

  function capture(event: string, props: Record<string, unknown> = {}) {
    const posthog = (window as unknown as { posthog?: { capture?: Capture } }).posthog;
    posthog?.capture?.(event, props);
  }

  function initInstallTabs() {
    const root = document.querySelector<HTMLElement>('.install-tabs');
    if (!root) return;
    const tabButtons = root.querySelectorAll<HTMLButtonElement>('.tab-button');
    const tabPanels = root.querySelectorAll<HTMLElement>('.tab-panel');
    const nextStep = root.querySelector<HTMLElement>('.next-step');
    const isMac = /mac/i.test(navigator.userAgent);

    // Default to PowerShell on Windows, the shell script everywhere else.
    const detectedTab = /win/i.test(navigator.userAgent) ? 'pwsh' : 'bash';

    function switchToTab(tabId: string) {
      tabButtons.forEach((btn) => {
        btn.setAttribute('aria-selected', btn.dataset.tab === tabId ? 'true' : 'false');
      });
      tabPanels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tabId;
      });
    }

    switchToTab(detectedTab);

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.dataset.tab) switchToTab(button.dataset.tab);
      });
    });

    function copied(method: string, via: string) {
      capture('install_command_copied', { method, via, detected_tab: detectedTab, used_detected_tab: method === detectedTab });
      if (nextStep) nextStep.hidden = false;
    }

    root.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
      button.addEventListener('click', async () => {
        const command = button.dataset.command ?? '';
        const method = button.dataset.method ?? '';
        const label = button.querySelector('.copy-label');
        let message = 'Copied';
        try {
          await navigator.clipboard.writeText(command);
          copied(method, 'button');
        } catch {
          // Clipboard access can be blocked; select the command so a keyboard copy works.
          const code = button.parentElement?.querySelector('.command');
          if (code) window.getSelection()?.selectAllChildren(code);
          message = isMac ? 'Press ⌘C' : 'Press Ctrl+C';
          capture('install_command_copy_failed', { method });
        }
        button.classList.add('copied');
        if (label) label.textContent = message;
        setTimeout(() => {
          button.classList.remove('copied');
          if (label) label.textContent = 'Copy';
        }, 2500);
      });
    });

    // Count copies made by selecting the command text by hand.
    root.querySelectorAll<HTMLElement>('.command').forEach((code) => {
      code.addEventListener('copy', () => copied(code.dataset.method ?? '', 'selection'));
    });

    root.querySelector<HTMLButtonElement>('.share-button')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const url = 'https://www.zvm.app/';
      try {
        if (navigator.share) {
          await navigator.share({ title: 'ZVM, the Zig Version Manager', url });
          capture('install_link_shared', { via: 'share' });
        } else {
          await navigator.clipboard.writeText(url);
          button.textContent = 'Link copied';
          capture('install_link_shared', { via: 'clipboard' });
        }
      } catch {
        // Closing the share sheet rejects; nothing to do.
      }
    });
  }

  initInstallTabs();
  document.addEventListener('astro:after-swap', initInstallTabs);
</script>
