---
import { Image } from 'astro:assets';
import logo from '../assets/zvm-logo.png';
---

<zvm-chat class="not-content ph-no-capture ph-mask" data-ph-capture-attribute-chat="false">
  <button class="chat-launcher" aria-label="Ask about Zig and ZVM" aria-expanded="false" aria-controls="zvm-chat-panel">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-8 8H5l-3 3V11.5a9 9 0 1 1 18 0Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M7 10h8M7 14h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <span>Ask ZVM</span>
  </button>

  <section id="zvm-chat-panel" class="chat-panel" role="dialog" aria-labelledby="zvm-chat-title" hidden>
    <header class="chat-header">
      <div class="chat-identity">
        <Image src={logo} width={44} height={44} alt="" />
        <div><h2 id="zvm-chat-title">A little Zig help.</h2><p>ZVM documentation assistant</p></div>
      </div>
      <button class="chat-close chat-icon" aria-label="Close chat" title="Close chat">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </header>

    <div class="chat-conversation" tabindex="0" aria-label="Conversation">
      <div class="chat-welcome">
        <span class="chat-eyebrow">LESS SETUP. MORE ZIG.</span>
        <h3>What are you building?</h3>
        <p>Get Zig installed, find the right version, or get unstuck. Let’s put ZVM to work.</p>
        <div class="chat-starters" aria-label="Suggested questions">
          <button data-question="How do I get started with Zig using ZVM?">Get started with Zig <span aria-hidden="true">↗</span></button>
          <button data-question="How can I use a different Zig version for each project with ZVM?">Use Zig per project <span aria-hidden="true">↗</span></button>
          <button data-question="How do I install ZLS with ZVM and set it up in my editor?">Set up ZLS <span aria-hidden="true">↗</span></button>
        </div>
      </div>
      <div class="chat-messages" role="log" aria-label="Messages" aria-live="off"></div>
    </div>

    <div class="chat-notice" role="status" aria-live="polite"></div>
    <div class="chat-recovery" hidden><button class="chat-retry">Try again</button><a href="/guides/install-zvm/">Browse the docs ↗</a></div>
    <form class="chat-form">
      <label class="sr-only" for="zvm-chat-input">Your Zig or ZVM question</label>
      <textarea id="zvm-chat-input" rows="2" maxlength="4000" placeholder="Ask about Zig or ZVM…" required></textarea>
      <button class="chat-send chat-icon" type="submit" aria-label="Send message" title="Send message">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="chat-stop" type="button" hidden>Stop</button>
    </form>
    <footer class="chat-footer"><span>AI help, grounded in the docs.</span><button class="chat-reset" type="button">New chat</button></footer>
    <p class="chat-privacy">Messages go to our AI provider. Don’t share secrets.</p>
  </section>
</zvm-chat>

<script>
  import '../lib/chat-widget';
</script>

<style>
  zvm-chat { --chat-border: var(--sl-color-gray-5); position: fixed; right: max(1.5rem, env(safe-area-inset-right)); bottom: max(1.5rem, env(safe-area-inset-bottom)); z-index: 100; font-family: var(--sl-font), sans-serif; font-size: 1rem; line-height: 1.5; color: var(--sl-color-white); }
  zvm-chat :global(*) { box-sizing: border-box; }
  zvm-chat :global([hidden]) { display: none !important; }
  zvm-chat :global(button), textarea { font: inherit; }
  zvm-chat :global(button) { cursor: pointer; }
  zvm-chat :global(button:disabled) { cursor: wait; opacity: .6; }
  .chat-launcher { display: flex; align-items: center; gap: .65rem; margin-left: auto; padding: .85rem 1.2rem; border: 2px solid var(--zvm-ink); border-radius: 999px; background: var(--zvm-orange); color: var(--zvm-ink); font-weight: 750; box-shadow: 3px 4px 0 var(--zvm-ink); transition: transform .15s; }
  .chat-launcher:hover { transform: translateY(-2px); }
  .chat-panel { display: flex; flex-direction: column; width: 390px; height: min(660px, calc(100dvh - 7.5rem)); max-height: calc(100dvh - 7.5rem); margin-bottom: 1.1rem; overflow: hidden; border: 2px solid var(--zvm-ink); border-radius: 1.25rem; background: var(--sl-color-black); box-shadow: 5px 6px 0 var(--zvm-ink), 0 12px 50px #0003; }
  .chat-panel { position: absolute; right: 0; bottom: 100%; }
  .chat-header { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: 1.2rem 1rem; background: var(--zvm-orange); color: var(--zvm-ink); border-bottom: 2px solid var(--zvm-ink); }
  .chat-identity { display: flex; align-items: center; gap: .65rem; }
  .chat-identity img { flex-shrink: 0; }
  .chat-header h2 { font-family: var(--zvm-font-display); font-weight: 600; font-size: .95rem; line-height: 1.4; margin: 0; }
  .chat-header p { font-size: .8rem; margin: .2rem 0 0; }
  .chat-icon { display: grid; place-items: center; flex-shrink: 0; width: 36px; height: 36px; border: 0; border-radius: 50%; }
  .chat-close { background: transparent; color: var(--zvm-ink); }
  .chat-close:hover { background: #1d161115; }
  .chat-conversation { flex: 1; min-height: 0; overflow-y: auto; padding: 1.35rem 1rem .6rem; overscroll-behavior: contain; scrollbar-width: thin; }
  .chat-eyebrow { color: var(--sl-color-accent-high); font-family: var(--sl-font-mono); font-size: .65rem; letter-spacing: .08em; }
  .chat-welcome h3 { font-family: var(--zvm-font-display); font-size: 1.25rem; font-weight: 600; line-height: 1.4; margin: .75rem 0; }
  .chat-welcome p { color: var(--sl-color-gray-2); font-size: .95rem; margin: 0 0 1.25rem; }
  .chat-starters { display: grid; gap: .55rem; margin-bottom: 1rem; }
  .chat-starters button { display: flex; align-items: center; justify-content: space-between; padding: .75rem .85rem; text-align: left; border: 1px solid var(--chat-border); border-radius: .65rem; background: var(--sl-color-gray-6); color: var(--sl-color-white); font-size: .9rem; }
  .chat-starters button:hover { border-color: var(--sl-color-accent); }
  .chat-starters span { color: var(--sl-color-accent-high); }
  .chat-messages :global(.chat-message) { width: fit-content; max-width: 100%; margin: 0 0 1rem; padding: .85rem; border: 1px solid var(--chat-border); border-radius: .85rem .85rem .85rem .15rem; font-size: .93rem; overflow-wrap: anywhere; }
  .chat-messages :global(.chat-message-user) { margin-left: auto; max-width: 90%; background: var(--sl-color-accent-low); border-color: transparent; border-radius: .85rem .85rem .15rem .85rem; white-space: pre-wrap; }
  .chat-messages :global(.chat-message-assistant) { background: var(--sl-color-gray-6); }
  .chat-messages :global(.chat-message > :first-child) { margin-top: 0; }
  .chat-messages :global(.chat-message > :last-child) { margin-bottom: 0; }
  .chat-messages :global(p) { margin: .65rem 0; }
  .chat-messages :global(pre) { padding: .8rem; border-radius: .45rem; background: var(--zvm-ink); color: var(--zvm-cream); overflow-x: auto; font-size: .8rem; white-space: pre; }
  .chat-messages :global(code) { font-family: var(--sl-font-mono); font-size: .85em; }
  .chat-messages :global(:not(pre) > code) { background: var(--sl-color-gray-5); padding: .1em .25em; border-radius: .2em; }
  .chat-messages :global(a) { color: var(--sl-color-accent-high); text-underline-offset: .2em; }
  .chat-messages :global(ul), .chat-messages :global(ol) { padding-left: 1.3rem; }
  .chat-messages :global(h3), .chat-messages :global(h4) { font-size: 1em; margin-block: .8rem .4rem; }
  .chat-notice { min-height: 1.7rem; padding: 0 1rem .3rem; color: var(--sl-color-gray-2); font-size: .8rem; }
  .chat-recovery { display: flex; gap: .75rem; padding: 0 1rem .7rem; font-size: .85rem; }
  .chat-recovery button, .chat-reset { border: 0; padding: 0; background: transparent; color: var(--sl-color-accent-high); text-decoration: underline; text-underline-offset: .2em; }
  .chat-recovery a { color: var(--sl-color-accent-high); }
  .chat-form { display: flex; align-items: center; gap: .5rem; margin: 0 .85rem; padding: .65rem; border: 1px solid var(--chat-border); border-radius: .8rem; background: var(--sl-color-gray-6); }
  .chat-form:focus-within { border-color: var(--sl-color-accent); }
  textarea { display: block; resize: none; width: 100%; min-width: 0; max-height: 8rem; border: 0; padding: .1rem; background: transparent; color: var(--sl-color-white); font-size: .95rem; }
  textarea::placeholder { color: var(--sl-color-gray-3); }
  textarea:focus-visible { outline: none; }
  .chat-send { color: var(--zvm-ink); background: var(--zvm-orange); border: 1px solid var(--zvm-ink); }
  .chat-stop { border: 1px solid var(--chat-border); background: transparent; border-radius: .4rem; color: var(--sl-color-white); font-size: .8rem; padding: .35rem; }
  .chat-footer { display: flex; justify-content: space-between; gap: .5rem; padding: .65rem 1rem .25rem; font-size: .72rem; color: var(--sl-color-gray-2); }
  .chat-privacy { margin: 0; padding: 0 1rem .8rem; color: var(--sl-color-gray-2); font-size: .65rem; }
  @media (max-width: 450px) {
    zvm-chat { right: max(.85rem, env(safe-area-inset-right)); bottom: max(.85rem, env(safe-area-inset-bottom)); }
    .chat-panel { width: calc(100vw - 1.7rem); height: min(660px, calc(100dvh - 6.5rem)); max-height: calc(100dvh - 6.5rem); }
    .chat-launcher { padding: .75rem 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .chat-launcher { transition: none; } }
</style>
